{% comment %}
  MerlinsMart overrides — all custom CSS lives here, not in Horizon's own files,
  so theme updates stay clean and this is trivial to remove.

  TEMPORARY (build phase): replaces Shopify's teal/coral demo placeholders with
  MerlinsMart-toned placeholders, so empty slots read as "photography to come"
  rather than as someone else's art direction. Lets the layout be judged and
  finished before any real imagery exists.

  TO REMOVE AT LAUNCH: delete this file, delete the two mm-placeholder-*.svg
  assets, and remove the {%- render 'mm-overrides' -%} line from layout/theme.liquid.
{% endcomment %}

{%- assign ph_wide = 'mm-placeholder-wide.svg' | asset_url -%}
{%- assign ph_square = 'mm-placeholder-square.svg' | asset_url -%}

<style>
  /* Hide Shopify's demo artwork wherever it renders. */
  .placeholder-svg,
  svg[class*='placeholder'] {
    opacity: 0 !important;
  }

  /* Paint MM placeholders onto the containers instead. */
  .placeholder-svg,
  svg[class*='placeholder'],
  [class*='placeholder'] {
    background-color: #EDE6D8;
    background-image: url({{ ph_square }});
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Wide slots — heroes and editorial media — get the landscape version. */
  .banner__media [class*='placeholder'],
  .background-media [class*='placeholder'],
  .media-block__placeholder,
  .media-with-content [class*='placeholder'],
  [class*='hero'] [class*='placeholder'] {
    background-image: url({{ ph_wide }});
  }

  /* Empty media blocks that render no svg at all still need a fill. */
  .media-with-content__media:empty,
  .media-block:empty {
    background-color: #EDE6D8;
    background-image: url({{ ph_wide }});
    background-size: cover;
    background-position: center;
    min-height: 320px;
  }
</style>
