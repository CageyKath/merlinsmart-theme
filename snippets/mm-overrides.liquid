{% comment %}
  MerlinsMart overrides — all custom CSS lives here, not in Horizon's own files.

  TEMPORARY (build phase): replaces Shopify's demo placeholder artwork with
  MerlinsMart-toned placeholders so empty slots read as intentional.

  NOTE: do NOT use opacity to hide the placeholder svg — opacity applies to the
  element's background too, which blanks the replacement image and leaves an
  empty void. Make the svg's shapes transparent instead and paint the
  background on the svg itself.

  TO REMOVE AT LAUNCH: delete this file, delete the two mm-placeholder-*.svg
  assets, and remove {%- render 'mm-overrides' -%} from layout/theme.liquid.
{% endcomment %}

{%- assign ph_wide = 'mm-placeholder-wide.svg' | asset_url -%}
{%- assign ph_square = 'mm-placeholder-square.svg' | asset_url -%}

<style>
  /* Square placeholder: product cards and galleries. */
  svg[class*='placeholder'] {
    background-color: #EDE6D8;
    background-image: url({{ ph_square }});
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Hide Shopify's demo artwork without hiding the element. */
  svg[class*='placeholder'] path,
  svg[class*='placeholder'] rect,
  svg[class*='placeholder'] circle,
  svg[class*='placeholder'] ellipse,
  svg[class*='placeholder'] polygon,
  svg[class*='placeholder'] g {
    fill: transparent !important;
    stroke: none !important;
  }

  /* Wide placeholder: hero and editorial media blocks. */
  .media-block__placeholder,
  .banner__media svg[class*='placeholder'],
  .background-media svg[class*='placeholder'],
  .media-with-content svg[class*='placeholder'] {
    background-image: url({{ ph_wide }});
  }

  /* Editorial media slot must hold height when empty. */
  .media-block__media {
    min-height: 320px;
  }
</style>
