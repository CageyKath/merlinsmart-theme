{% comment %}
  MerlinsMart overrides — all custom CSS lives here, not in Horizon's own files.

  TEMPORARY (build phase): replaces Shopify's demo placeholder artwork with
  MerlinsMart-toned placeholders so empty slots read as intentional.

  TWO TRAPS, both hit during the build — do not reintroduce:
  1. Do NOT use opacity to hide the placeholder svg. Opacity applies to the
     element's background too, which blanks the replacement and leaves a void.
     Make the svg's shapes transparent instead.
  2. Put the background on the CONTAINER as well as the svg. Horizon wraps
     placeholders in .media-block / .hero__media, and targeting the svg alone
     misses cases where it is sized or positioned differently.

  TO REMOVE AT LAUNCH: delete this file, delete the two mm-placeholder-*.svg
  assets, and remove {%- render 'mm-overrides' -%} from layout/theme.liquid.
{% endcomment %}

{%- assign ph_wide = 'mm-placeholder-wide.svg' | asset_url -%}
{%- assign ph_square = 'mm-placeholder-square.svg' | asset_url -%}
{%- assign ph_auburn = 'mm-auburn-coming-soon.svg' | asset_url -%}

<style>
  /* 1. Erase Shopify's demo artwork without hiding the element. */
  svg[class*='placeholder'] path,
  svg[class*='placeholder'] rect,
  svg[class*='placeholder'] circle,
  svg[class*='placeholder'] ellipse,
  svg[class*='placeholder'] polygon,
  svg[class*='placeholder'] g,
  svg[class*='placeholder'] use {
    fill: transparent !important;
    stroke: none !important;
  }

  /* 2. Square placeholder — product cards, galleries, generic slots. */
  svg[class*='placeholder'],
  .card-gallery__placeholder,
  .product-media-gallery__placeholder-image {
    background-color: #EDE6D8 !important;
    background-image: url({{ ph_square }}) !important;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
  }

  /* 3. Wide placeholder — hero and editorial media. Container AND svg, and
        listed after the square rule so it wins regardless of specificity. */
  .hero__media,
  .hero__media svg[class*='placeholder'],
  .media-block,
  .media-block svg[class*='placeholder'],
  .media-block__media,
  .media-block__placeholder,
  .media-with-content .media-block,
  .background-media,
  .background-media svg[class*='placeholder'] {
    background-color: #EDE6D8 !important;
    background-image: url({{ ph_wide }}) !important;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
  }

  /* 4. Editorial media slots must hold height when they have no image. */
  .media-block,
  .media-block__media {
    min-height: 340px;
  }

  /* 5. Auburn's module is CONTENT ("coming soon"), not a missing photo — its
        own purpose-built graphic, scoped to that section only. Section id
        comes from the JSON template key "auburn_feature"; Shopify wraps every
        section in #shopify-section-{key} automatically. */
  #shopify-section-auburn_feature .media-block,
  #shopify-section-auburn_feature .media-block svg[class*='placeholder'] {
    background-image: url({{ ph_auburn }}) !important;
  }

  /* 6. LAUNCH-PHASE "Coming Soon" ribbon — Kathy, Sep 5 2026: wants a diagonal
        corner ribbon instead of the flat "Sold out" pill while real inventory
        isn't in hand yet, without obscuring the product photo. Deliberately
        NOT a settings toggle — it is wired to product.available in
        blocks/_product-card-gallery.liquid, so it disappears on its own the
        moment a product has real stock again. Nothing to remember to revert.
        TO REMOVE EARLY (if ever wanted before real launch does it
        automatically): delete this block and the matching Liquid block in
        blocks/_product-card-gallery.liquid. */
  .mm-coming-soon-ribbon {
    position: absolute;
    top: 18px;
    left: -34px;
    z-index: var(--layer-flat, 2);
    width: 150px;
    transform: rotate(-45deg);
    transform-origin: center;
    pointer-events: none;
  }

  .mm-coming-soon-ribbon span {
    display: block;
    padding-block: 6px;
    text-align: center;
    background: #241A14;
    color: #F7F2E8;
    font-family: var(--font-subheading--family, sans-serif);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-block: 1px solid #B68B3A;
  }
</style>
